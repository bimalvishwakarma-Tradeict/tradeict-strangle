APP_SECRET_KEY=your-32-char-secret-key-here
# JWT signing secret for dashboard login (required — app will not start without it)
AUTH_SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///./trading_bot.db
BACKEND_PORT=8000
FRONTEND_PORT=5173
DELTA_EXCHANGE_BASE_URL=https://api.india.delta.exchange
# Shared secret for HMAC (x-internal-signature) on Earner webhooks.
# Must match Earner's BOT_WEBHOOK_SECRET. Empty = webhook disabled.
BOT_WEBHOOK_SECRET=
# Options trading fee estimate (paid fees always from Delta fill commission)
OPTION_FEE_RATE=0.00010
PREMIUM_CAP_RATE=0.035
GST_RATE=0.18
OPTIONS_CONTRACT_VALUE=0.001
